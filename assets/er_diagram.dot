digraph PoliceTrackingERD {
    graph [
        rankdir=TB,
        splines=spline,
        nodesep=0.5,
        ranksep=0.7,
        bgcolor="#FFFFFF",
        pad="0.3"
    ];
    
    node [
        shape=none,
        fontname="Helvetica, Arial, sans-serif",
        fontsize=10
    ];
    
    edge [
        arrowsize=0.75,
        penwidth=1.3,
        fontname="Helvetica, Arial, sans-serif",
        fontsize=8.5
    ];

    // Subgraphs for aesthetic grouping
    { rank=same; Officers; Complaints; Persons; }
    { rank=same; Assignments; InvestigationActivities; CustodyLogs; Witnesses; }
    { rank=same; EvidenceItems; StatusHistories; CourtReferences; Charges; }

    Complaints [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#1E40AF" colspan="3"><font color="#FFFFFF"><b>Complaints</b></font></td></tr>
            <tr><td align="left"><b>complaint_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">title</td><td></td><td align="left">VARCHAR(100)</td></tr>
            <tr><td align="left">description</td><td></td><td align="left">TEXT</td></tr>
            <tr><td align="left">incident_date</td><td></td><td align="left">DATE</td></tr>
            <tr><td align="left">filed_date</td><td></td><td align="left">TIMESTAMP</td></tr>
            <tr><td align="left">status</td><td></td><td align="left">ENUM(...)</td></tr>
            <tr><td align="left">closure_details</td><td></td><td align="left">TEXT</td></tr>
        </table>
    >];

    Officers [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#065F46" colspan="3"><font color="#FFFFFF"><b>Officers</b></font></td></tr>
            <tr><td align="left"><b>officer_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">badge_number</td><td align="center"><font color="#059669"><b>UK</b></font></td><td align="left">VARCHAR(20)</td></tr>
            <tr><td align="left">first_name</td><td></td><td align="left">VARCHAR(50)</td></tr>
            <tr><td align="left">last_name</td><td></td><td align="left">VARCHAR(50)</td></tr>
            <tr><td align="left">rank</td><td></td><td align="left">VARCHAR(50)</td></tr>
            <tr><td align="left">contact_number</td><td></td><td align="left">VARCHAR(15)</td></tr>
        </table>
    >];

    Persons [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#7E22CE" colspan="3"><font color="#FFFFFF"><b>Persons</b></font></td></tr>
            <tr><td align="left"><b>person_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">first_name</td><td></td><td align="left">VARCHAR(50)</td></tr>
            <tr><td align="left">last_name</td><td></td><td align="left">VARCHAR(50)</td></tr>
            <tr><td align="left">dob</td><td></td><td align="left">DATE</td></tr>
            <tr><td align="left">address</td><td></td><td align="left">VARCHAR(255)</td></tr>
            <tr><td align="left">contact_number</td><td></td><td align="left">VARCHAR(15)</td></tr>
            <tr><td align="left">role</td><td></td><td align="left">ENUM(...)</td></tr>
        </table>
    >];

    Assignments [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#1F2937" colspan="3"><font color="#FFFFFF"><b>Assignments</b></font></td></tr>
            <tr><td align="left"><b>assignment_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">complaint_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">officer_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">assignment_date</td><td></td><td align="left">DATE</td></tr>
            <tr><td align="left">role</td><td></td><td align="left">VARCHAR(50)</td></tr>
        </table>
    >];

    InvestigationActivities [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#1F2937" colspan="3"><font color="#FFFFFF"><b>InvestigationActivities</b></font></td></tr>
            <tr><td align="left"><b>activity_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">complaint_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">officer_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">activity_date</td><td></td><td align="left">TIMESTAMP</td></tr>
            <tr><td align="left">description</td><td></td><td align="left">TEXT</td></tr>
        </table>
    >];

    CustodyLogs [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#1F2937" colspan="3"><font color="#FFFFFF"><b>CustodyLogs</b></font></td></tr>
            <tr><td align="left"><b>log_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">person_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">officer_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">check_in_time</td><td></td><td align="left">DATETIME</td></tr>
            <tr><td align="left">check_out_time</td><td></td><td align="left">DATETIME</td></tr>
            <tr><td align="left">location</td><td></td><td align="left">VARCHAR(100)</td></tr>
        </table>
    >];

    Witnesses [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#1F2937" colspan="3"><font color="#FFFFFF"><b>Witnesses</b></font></td></tr>
            <tr><td align="left"><b>witness_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">complaint_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">person_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">statement</td><td></td><td align="left">TEXT</td></tr>
            <tr><td align="left">statement_date</td><td></td><td align="left">DATE</td></tr>
        </table>
    >];

    EvidenceItems [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#374151" colspan="3"><font color="#FFFFFF"><b>EvidenceItems</b></font></td></tr>
            <tr><td align="left"><b>evidence_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">complaint_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">description</td><td></td><td align="left">TEXT</td></tr>
            <tr><td align="left">collection_date</td><td></td><td align="left">DATE</td></tr>
            <tr><td align="left">collected_by</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">current_location</td><td></td><td align="left">VARCHAR(100)</td></tr>
        </table>
    >];

    StatusHistories [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#374151" colspan="3"><font color="#FFFFFF"><b>StatusHistories</b></font></td></tr>
            <tr><td align="left"><b>history_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">complaint_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">status</td><td></td><td align="left">ENUM(...)</td></tr>
            <tr><td align="left">change_date</td><td></td><td align="left">TIMESTAMP</td></tr>
            <tr><td align="left">remarks</td><td></td><td align="left">TEXT</td></tr>
        </table>
    >];

    CourtReferences [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#374151" colspan="3"><font color="#FFFFFF"><b>CourtReferences</b></font></td></tr>
            <tr><td align="left"><b>court_ref_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">complaint_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">court_name</td><td></td><td align="left">VARCHAR(100)</td></tr>
            <tr><td align="left">hearing_date</td><td></td><td align="left">DATE</td></tr>
            <tr><td align="left">case_number</td><td></td><td align="left">VARCHAR(50)</td></tr>
        </table>
    >];

    Charges [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="rounded">
            <tr><td bgcolor="#374151" colspan="3"><font color="#FFFFFF"><b>Charges</b></font></td></tr>
            <tr><td align="left"><b>charge_id</b></td><td align="center"><font color="#DC2626"><b>PK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">complaint_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">person_id</td><td align="center"><font color="#2563EB"><b>FK</b></font></td><td align="left">INT</td></tr>
            <tr><td align="left">description</td><td></td><td align="left">TEXT</td></tr>
        </table>
    >];

    // Relationships
    Complaints -> Assignments [label="1 : N", color="#2563EB"];
    Complaints -> InvestigationActivities [label="1 : N", color="#2563EB"];
    Complaints -> EvidenceItems [label="1 : N", color="#2563EB"];
    Complaints -> Witnesses [label="1 : N", color="#2563EB"];
    Complaints -> StatusHistories [label="1 : N", color="#2563EB"];
    Complaints -> CourtReferences [label="1 : N", color="#2563EB"];
    Complaints -> Charges [label="1 : N", color="#2563EB"];

    Officers -> Assignments [label="1 : N", color="#059669"];
    Officers -> InvestigationActivities [label="1 : N", color="#059669"];
    Officers -> EvidenceItems [label="1 : N (collected_by)", color="#059669"];
    Officers -> CustodyLogs [label="1 : N (supervising)", color="#059669"];

    Persons -> CustodyLogs [label="1 : N", color="#7E22CE"];
    Persons -> Witnesses [label="1 : N", color="#7E22CE"];
    Persons -> Charges [label="1 : N", color="#7E22CE"];
}
